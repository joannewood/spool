POSTGRES_USER=spool
POSTGRES_PASSWORD=changeme
POSTGRES_DB=spool

# Real host paths for the three watched roots. Used in three places:
#  - docker-compose.yml bind-mounts these into watcher/worker/worker-step
#  - db/migrations/003_seed_watched_roots.sh seeds the `watched_roots`
#    table with them (only takes effect on a brand-new `pgdata` volume —
#    see the migrations gotcha in CLAUDE.md)
#  - host-helper's install script reads these too, so the native
#    delete-allowlist (ALLOWED_DELETE_ROOTS) matches what's actually
#    mounted — re-run install.sh/install_windows.ps1 if you change these later
#
# On Windows: use forward slashes, not backslashes, even though that
# looks unusual for a Windows path (e.g. "C:/Users/you/3DPrintFiles", not
# "C:\Users\you\3DPrintFiles"). Windows itself accepts forward slashes
# everywhere that matters here, and it's what lets the app's own
# container-side code treat this as a plain path string with no
# Windows-vs-Mac special-casing. setup.ps1 does this conversion for you
# automatically if you use it instead of editing this file by hand.
DROPFOLDER_HOST_PATH=/Users/YOU/Documents/3DPrintFiles
LIBRARY_HOST_PATH=/Users/YOU/Documents/3D Printing
DOWNLOADS_HOST_PATH=/Users/YOU/Downloads
