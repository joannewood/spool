POSTGRES_USER=spool
POSTGRES_PASSWORD=changeme
POSTGRES_DB=spool

# Real host paths for the three watched roots. Used in three places:
#  - docker-compose.yml bind-mounts these into watcher/worker/worker-step
#  - db/migrations/003_seed_watched_roots.sh seeds the `watched_roots`
#    table with them (only takes effect on a brand-new `pgdata` volume —
#    see the migrations gotcha in CLAUDE.md)
#  - host-helper/install.sh reads these too, so the native delete-allowlist
#    (host-helper/host_helper.py's ALLOWED_DELETE_ROOTS) matches what's
#    actually mounted — re-run install.sh if you change these later
DROPFOLDER_HOST_PATH=/Users/YOU/Documents/3DPrintFiles
LIBRARY_HOST_PATH=/Users/YOU/Documents/3D Printing
DOWNLOADS_HOST_PATH=/Users/YOU/Downloads
